{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Information",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:80",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://*:443",
        "Protocols": "Http2"
      }
    }
  },
  "DevMode": {
    "Enabled": false
  },
  "Server": {
    "Paths": {
      "AssetDatabase": "",
      "MasterDatabase": "",
      "ResourcesBaseUrl": ""
    },
    "Data": {
      "LatestMasterDataVersion": "",
      "UserDataPath": "",
      "UserDatabase": "userdata.json"
    }
  }
}
